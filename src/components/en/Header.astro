<header class="border-b border-[#E7D6C7] bg-[#FFF8E7]">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex h-20 items-center justify-between">

      <!-- Logo -->
      <a
        href="#top"
        class="group flex items-baseline gap-2"
        aria-label="Azu, your Caregiver"
      >
        <span
          class="font-serif text-2xl tracking-[-0.02em] text-[#2B211C]"
        >
          Azu
        </span>

        <span
          class="text-[10px] font-medium uppercase tracking-[0.18em] text-[#C96F3D]"
        >
          your Caregiver
        </span>
      </a>


      <!-- Desktop navigation -->
      <nav
        class="hidden items-center gap-7 md:flex"
        aria-label="Main navigation"
      >

        <a
          href="#about"
          class="text-xs font-medium tracking-[0.08em] text-[#68584D] transition-colors hover:text-[#C96F3D]"
        >
          About
        </a>

        <a
          href="#approach"
          class="text-xs font-medium tracking-[0.08em] text-[#68584D] transition-colors hover:text-[#C96F3D]"
        >
          My Approach
        </a>

        <a
          href="#services"
          class="text-xs font-medium tracking-[0.08em] text-[#68584D] transition-colors hover:text-[#C96F3D]"
        >
          Services
        </a>

        <a
          href="#kind-words"
          class="text-xs font-medium tracking-[0.08em] text-[#68584D] transition-colors hover:text-[#C96F3D]"
        >
          Kind Words
        </a>

        <a
          href="#faq"
          class="text-xs font-medium tracking-[0.08em] text-[#68584D] transition-colors hover:text-[#C96F3D]"
        >
          FAQ
        </a>

        <a
          href="#contact"
          class="ml-1 inline-flex items-center justify-center bg-[#C96F3D] px-5 py-2.5 text-xs font-medium tracking-[0.08em] text-[#FFFDF8] transition-colors hover:bg-[#2B211C]"
        >
          Contact
        </a>

      </nav>


      <!-- Language selector -->
      <div class="hidden items-center gap-1 border-l border-[#E7D6C7] pl-5 md:flex">

        <a
          href="/"
          class="px-1.5 py-1 text-[10px] font-medium tracking-[0.12em] text-[#C96F3D]"
          aria-label="English"
          aria-current="page"
        >
          EN
        </a>

        <span class="text-xs text-[#E7D6C7]">/</span>

        <a
          href="/fr/"
          class="px-1.5 py-1 text-[10px] font-medium tracking-[0.12em] text-[#68584D] transition-colors hover:text-[#C96F3D]"
          aria-label="Français"
        >
          FR
        </a>

        <span class="text-xs text-[#E7D6C7]">/</span>

        <a
          href="/ja/"
          class="px-1.5 py-1 text-[10px] font-medium tracking-[0.12em] text-[#68584D] transition-colors hover:text-[#C96F3D]"
          aria-label="日本語"
        >
          JP
        </a>

      </div>


      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="flex h-10 w-10 items-center justify-center border border-[#E7D6C7] text-[#2B211C] md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="flex flex-col gap-1.5">
          <span class="block h-px w-5 bg-[#2B211C]"></span>
          <span class="block h-px w-5 bg-[#2B211C]"></span>
        </span>
      </button>

    </div>


    <!-- Mobile navigation -->
    <div
      id="mobile-menu"
      class="hidden border-t border-[#E7D6C7] py-6 md:hidden"
    >
      <nav
        class="flex flex-col"
        aria-label="Mobile navigation"
      >

        <a
          href="#about"
          class="border-b border-[#E7D6C7] py-4 text-sm font-medium tracking-[0.08em] text-[#68584D]"
        >
          About
        </a>

        <a
          href="#approach"
          class="border-b border-[#E7D6C7] py-4 text-sm font-medium tracking-[0.08em] text-[#68584D]"
        >
          My Approach
        </a>

        <a
          href="#services"
          class="border-b border-[#E7D6C7] py-4 text-sm font-medium tracking-[0.08em] text-[#68584D]"
        >
          Services
        </a>

        <a
          href="#kind-words"
          class="border-b border-[#E7D6C7] py-4 text-sm font-medium tracking-[0.08em] text-[#68584D]"
        >
          Kind Words
        </a>

        <a
          href="#faq"
          class="border-b border-[#E7D6C7] py-4 text-sm font-medium tracking-[0.08em] text-[#68584D]"
        >
          FAQ
        </a>

        <a
          href="#contact"
          class="mt-5 inline-flex items-center justify-center bg-[#C96F3D] px-5 py-3 text-sm font-medium tracking-[0.08em] text-[#FFFDF8]"
        >
          Contact
        </a>


        <!-- Mobile language selector -->
        <div class="mt-6 flex items-center gap-1">

          <a
            href="/"
            class="px-1.5 py-1 text-[10px] font-medium tracking-[0.12em] text-[#C96F3D]"
            aria-label="English"
            aria-current="page"
          >
            EN
          </a>

          <span class="text-xs text-[#E7D6C7]">/</span>

          <a
            href="/fr/"
            class="px-1.5 py-1 text-[10px] font-medium tracking-[0.12em] text-[#68584D]"
            aria-label="Français"
          >
            FR
          </a>

          <span class="text-xs text-[#E7D6C7]">/</span>

          <a
            href="/ja/"
            class="px-1.5 py-1 text-[10px] font-medium tracking-[0.12em] text-[#68584D]"
            aria-label="日本語"
          >
            JP
          </a>

        </div>

      </nav>
    </div>

  </div>
</header>


<script>
  const menuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuButton && mobileMenu) {
    menuButton.addEventListener("click", () => {
      const isOpen = !mobileMenu.classList.contains("hidden");

      mobileMenu.classList.toggle("hidden");
      menuButton.setAttribute("aria-expanded", String(!isOpen));
      menuButton.setAttribute(
        "aria-label",
        isOpen ? "Open menu" : "Close menu"
      );
    });

    const mobileLinks = mobileMenu.querySelectorAll("a");

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.setAttribute("aria-label", "Open menu");
      });
    });
  }
</script>