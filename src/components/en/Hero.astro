<section
  id="hero"
  class="relative overflow-hidden bg-[#FFF8E7]"
>
  <div class="mx-auto max-w-7xl px-5 sm:px-6">
    <div
      class="relative flex min-h-0 flex-col items-center pb-16 pt-10
      md:min-h-[calc(90vh-80px)] md:flex-row md:items-center md:pb-0 md:pt-0"
    >

      <!-- Illustration -->
      <div
        class="relative flex w-full justify-center
        md:absolute md:left-[-3%] md:top-1/2 md:w-[59%] md:-translate-y-1/2
        lg:left-[-2%] lg:w-[58%]"
      >
        <img
          src="/images/hero-line-art.png"
          alt=""
          class="block h-auto w-[78%] max-w-[520px]
          sm:w-[72%]
          md:w-full md:max-w-none"
        />
      </div>


      <!-- Text -->
      <div
        class="relative z-10 mt-8 w-full
        md:ml-auto md:mt-0 md:w-[50%]
        lg:w-[48%] lg:max-w-2xl"
      >

        <!-- Eyebrow -->
        <p
          class="text-[10px] font-medium uppercase tracking-[0.2em] text-[#C96F3D]
          sm:text-[11px] sm:tracking-[0.24em]
          md:text-xs md:tracking-[0.28em]"
        >
          Private childcare - Tokyo &amp; Kanagawa
        </p>


        <!-- Decorative line -->
        <div
          class="mt-5 h-px w-10 bg-[#F2A06F]
          sm:mt-6 sm:w-12
          md:mt-8 md:w-14"
        ></div>


        <!-- Main heading -->
        <h1
          class="mt-6 font-serif text-[clamp(2.25rem,10vw,3.4rem)] font-normal leading-[0.94] tracking-[-0.035em] text-[#2B211C]
          sm:mt-7 sm:text-[clamp(2.5rem,8vw,4rem)]
          md:mt-8 md:text-[clamp(2.4rem,4vw,5rem)] md:leading-[0.94]"
        >
          <span class="block">
            Looking for more
          </span>

          <span
            class="mt-4 block pl-4
            sm:mt-5 sm:pl-6
            md:mt-8 md:pl-12 md:whitespace-nowrap"
          >
            than just a nanny?
          </span>
        </h1>


        <!-- Supporting text -->
        <div
          class="mt-7 max-w-xl
          sm:mt-8
          md:mt-8 md:pl-8"
        >

          <!-- Main supporting statement -->
          <p
            class="max-w-lg font-serif text-base leading-[1.6] text-[#68584D]
            sm:text-lg
            md:text-xl md:leading-relaxed"
          >
            Someone who truly understands,
            cares for, and connects with your child.
          </p>


          <!-- Service description -->
          <p
            class="mt-5 max-w-md text-xs leading-6 text-[#68584D]
            sm:text-sm sm:leading-7"
          >
            Thoughtful, personal childcare for local families,
            international residents, and families visiting Japan.
          </p>

        </div>

      </div>

    </div>
  </div>
</section>