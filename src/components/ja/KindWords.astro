<style>
  /*
   * Keep the review scrollbar subtle so it does not
   * compete with the typography and card design.
   */
  .review-text {
    scrollbar-width: thin;
    scrollbar-color: #e7d6c7 transparent;
  }

  .review-text::-webkit-scrollbar {
    width: 4px;
  }

  .review-text::-webkit-scrollbar-track {
    background: transparent;
  }

  .review-text::-webkit-scrollbar-thumb {
    background: #e7d6c7;
    border-radius: 9999px;
  }

  .review-text::-webkit-scrollbar-thumb:hover {
    background: #f2a06f;
  }
</style>


<script>
  const track = document.querySelector("#review-track");
  const prevButton = document.querySelector("#review-prev");
  const nextButton = document.querySelector("#review-next");
  const dotsContainer = document.querySelector("#review-dots");
  const slides = document.querySelectorAll(".review-slide");

  let currentIndex = 0;

  const totalReviews = slides.length;


  function getVisibleSlides() {
    if (window.innerWidth >= 1024) {
      return 3;
    }

    if (window.innerWidth >= 768) {
      return 2;
    }

    return 1;
  }


  function getMaxIndex() {
    const visibleSlides = getVisibleSlides();

    return Math.max(
      0,
      totalReviews - visibleSlides
    );
  }


  function updatePosition() {
    if (!track) {
      return;
    }

    const visibleSlides = getVisibleSlides();

    const slideWidth =
      100 / visibleSlides;

    track.style.transform =
      `translateX(-${currentIndex * slideWidth}%)`;
  }


  function updateButtons() {
    const maxIndex = getMaxIndex();

    if (prevButton) {
      prevButton.disabled =
        currentIndex === 0;
    }

    if (nextButton) {
      nextButton.disabled =
        currentIndex === maxIndex;
    }
  }


  function updateDots() {
    if (!dotsContainer) {
      return;
    }

    const maxIndex = getMaxIndex();

    dotsContainer.innerHTML = "";

    for (let i = 0; i <= maxIndex; i++) {
      const dot =
        document.createElement("span");

      if (i === currentIndex) {
        dot.className =
          "block h-2 w-2 rounded-full bg-[#C96F3D]";
      } else {
        dot.className =
          "block h-1.5 w-1.5 rounded-full bg-[#E7D6C7]";
      }

      dotsContainer.appendChild(dot);
    }
  }


  function updateCarousel() {
    updatePosition();
    updateButtons();
    updateDots();
  }


  function showNext() {
    const maxIndex = getMaxIndex();

    if (currentIndex < maxIndex) {
      currentIndex += 1;

      updateCarousel();
    }
  }


  function showPrevious() {
    if (currentIndex > 0) {
      currentIndex -= 1;

      updateCarousel();
    }
  }


  nextButton?.addEventListener(
    "click",
    showNext
  );


  prevButton?.addEventListener(
    "click",
    showPrevious
  );


  window.addEventListener(
    "resize",
    () => {
      const maxIndex = getMaxIndex();

      if (currentIndex > maxIndex) {
        currentIndex = maxIndex;
      }

      updateCarousel();
    }
  );


  updateCarousel();
</script>