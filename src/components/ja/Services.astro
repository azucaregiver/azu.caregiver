<section
  id="services"
  class="bg-[#FFFDF8] px-5 py-16 sm:px-6 sm:py-20 md:py-28"
>
  <div class="mx-auto max-w-7xl">

    <!-- Section heading -->
    <div
      class="grid gap-6
      sm:gap-8
      lg:grid-cols-[0.8fr_2fr] lg:items-start lg:gap-10"
    >

      <div class="pt-0 lg:pt-2">
        <p
          class="text-[10px] uppercase tracking-[0.22em] text-[#C96F3D]
          sm:text-xs sm:tracking-[0.28em]"
        >
          サービス
        </p>

        <div
          class="mt-4 h-px w-10 bg-[#F2A06F]
          sm:mt-6 sm:w-14"
        ></div>
      </div>

      <div>
        <h2
          class="max-w-2xl font-serif text-[2.5rem] leading-[1.05] tracking-[-0.025em] text-[#2B211C]
          sm:text-5xl sm:leading-tight
          md:text-6xl"
        >
          ご家族のニーズに合わせた保育。
        </h2>
      </div>

    </div>


    <!-- Service cards -->
    <div
      class="mt-10 grid gap-5
      sm:mt-12 sm:gap-6
      lg:mt-16 lg:grid-cols-3 lg:gap-5"
    >

      <!-- 01 Regular Care -->
      <article class="group">
        <div
          class="flex h-[330px] flex-col bg-[#F8EED9] p-6 transition-transform duration-300 group-hover:-translate-y-1
          sm:h-[350px] sm:p-7
          lg:h-[390px] lg:p-9"
        >

          <div class="flex items-center justify-between">
            <span
              class="text-[10px] font-medium tracking-[0.22em] text-[#C96F3D]
              sm:text-xs sm:tracking-[0.25em]"
            >
              01
            </span>

            <span class="h-px w-8 bg-[#F2A06F] sm:w-10"></span>
          </div>


          <div class="mt-8 sm:mt-10 lg:mt-12">
            <h3
              class="font-serif text-2xl leading-[1.05] tracking-[-0.02em] text-[#2B211C]
              sm:text-3xl
              lg:text-4xl"
            >
              定期保育
            </h3>

            <p
              class="mt-4 max-w-sm text-xs leading-6 text-[#68584D]
              sm:mt-5 sm:text-sm sm:leading-7"
            >
              ご家族の生活リズムやご予定に合わせて、
              定期的に安心してご利用いただける保育です。
            </p>
          </div>


          <div class="mt-auto pt-6 sm:pt-7 lg:pt-8">
            <p
              class="text-[10px] uppercase tracking-[0.15em] text-[#C96F3D]
              sm:text-xs sm:tracking-[0.18em]"
            >
              こんな方に
            </p>

            <p
              class="mt-2 text-xs leading-5 text-[#68584D]
              sm:mt-3 sm:text-sm sm:leading-6"
            >
              毎週 · 週2回 · 固定スケジュール
            </p>
          </div>

        </div>
      </article>


      <!-- 02 Occasional Care -->
      <article class="group">
        <div
          class="flex h-[330px] flex-col bg-[#F8EED9] p-6 transition-transform duration-300 group-hover:-translate-y-1
          sm:h-[350px] sm:p-7
          lg:h-[390px] lg:p-9"
        >

          <div class="flex items-center justify-between">
            <span
              class="text-[10px] font-medium tracking-[0.22em] text-[#C96F3D]
              sm:text-xs sm:tracking-[0.25em]"
            >
              02
            </span>

            <span class="h-px w-8 bg-[#F2A06F] sm:w-10"></span>
          </div>


          <div class="mt-8 sm:mt-10 lg:mt-12">
            <h3
              class="font-serif text-2xl leading-[1.05] tracking-[-0.02em] text-[#2B211C]
              sm:text-3xl
              lg:text-4xl"
            >
              スポット保育
            </h3>

            <p
              class="mt-4 max-w-sm text-xs leading-6 text-[#68584D]
              sm:mt-5 sm:text-sm sm:leading-7"
            >
              ご自身やご家族のために少し時間が必要なときなど、
              必要なタイミングで柔軟にご利用いただけます。
            </p>
          </div>


          <div class="mt-auto pt-6 sm:pt-7 lg:pt-8">
            <p
              class="text-[10px] uppercase tracking-[0.15em] text-[#C96F3D]
              sm:text-xs sm:tracking-[0.18em]"
            >
              こんな方に
            </p>

            <p
              class="mt-2 text-xs leading-5 text-[#68584D]
              sm:mt-3 sm:text-sm sm:leading-6"
            >
              デート · イベント · ご用事 · 東京滞在
            </p>
          </div>

        </div>
      </article>


      <!-- 03 Travel Companion -->
      <article class="group">
        <div
          class="flex h-[330px] flex-col bg-[#F2A06F] p-6 transition-transform duration-300 group-hover:-translate-y-1
          sm:h-[350px] sm:p-7
          lg:h-[390px] lg:p-9"
        >

          <div class="flex items-center justify-between">
            <span
              class="text-[10px] font-medium tracking-[0.22em] text-[#2B211C]
              sm:text-xs sm:tracking-[0.25em]"
            >
              03
            </span>

            <span
              class="h-px w-8 bg-[#C96F3D] sm:w-10"
            ></span>
          </div>


          <div class="mt-8 sm:mt-10 lg:mt-12">
            <h3
              class="font-serif text-2xl leading-[1.05] tracking-[-0.025em] text-[#2B211C]
              sm:text-3xl
              lg:text-4xl"
            >
              旅行同行
            </h3>

            <p
              class="mt-4 max-w-sm text-xs leading-6 text-[#2B211C]
              sm:mt-5 sm:text-sm sm:leading-7"
            >
              海外での長期旅行など、
              信頼できるシッターに同行してほしいご家族のための
              パーソナルな保育です。
            </p>
          </div>


          <div class="mt-auto pt-6 sm:pt-7 lg:pt-8">
            <p
              class="text-[10px] uppercase tracking-[0.15em] text-[#2B211C]
              sm:text-xs sm:tracking-[0.18em]"
            >
              こんな方に
            </p>

            <p
              class="mt-2 text-xs leading-5 text-[#2B211C]
              sm:mt-3 sm:text-sm sm:leading-6"
            >
              長期滞在 · 海外旅行 · 家族旅行
            </p>
          </div>

        </div>
      </article>

    </div>


    <!-- Practical information -->
    <div
      class="mt-10 border-t border-[#E7D6C7] pt-6
      sm:mt-12 sm:pt-8"
    >

      <div
        class="grid gap-5
        sm:grid-cols-2 sm:gap-7
        lg:grid-cols-4 lg:gap-8"
      >

        <div>
          <p
            class="text-[10px] uppercase tracking-[0.15em] text-[#C96F3D]
            sm:text-xs sm:tracking-[0.18em]"
          >
            料金
          </p>

          <p class="mt-2 text-xs text-[#68584D] sm:text-sm">
            ¥4,000 / 時間
          </p>
        </div>


        <div>
          <p
            class="text-[10px] uppercase tracking-[0.15em] text-[#C96F3D]
            sm:text-xs sm:tracking-[0.18em]"
          >
            最低利用時間
          </p>

          <p class="mt-2 text-xs text-[#68584D] sm:text-sm">
            2時間
          </p>
        </div>


        <div>
          <p
            class="text-[10px] uppercase tracking-[0.15em] text-[#C96F3D]
            sm:text-xs sm:tracking-[0.18em]"
          >
            お子さまの人数
          </p>

          <p class="mt-2 text-xs text-[#68584D] sm:text-sm">
            1〜4名
          </p>
        </div>


        <div>
          <p
            class="text-[10px] uppercase tracking-[0.15em] text-[#C96F3D]
            sm:text-xs sm:tracking-[0.18em]"
          >
            対象年齢
          </p>

          <p class="mt-2 text-xs text-[#68584D] sm:text-sm">
            1歳以上
          </p>
        </div>

      </div>

    </div>

  </div>
</section>