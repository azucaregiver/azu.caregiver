        <div>

          <div
            class="grid gap-5
            sm:grid-cols-2 sm:gap-8"
          >

            <!-- Languages -->
            <div>
              <p
                class="text-[10px] uppercase tracking-[0.15em] text-[#C96F3D]
                sm:text-xs sm:tracking-[0.18em]"
