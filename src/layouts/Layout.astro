import "../styles/global.css";

interface Props {
title?: string;
description?: string;
lang?: string;
canonical?: string;
}

const {
title = "Azu, your Caregiver | Private Babysitter in Tokyo",
description = "Private, English-speaking childcare and babysitting in Tokyo and Kanagawa for local families, international residents, and families visiting Japan.",
lang = "en",
canonical,
} = Astro.props;

const siteUrl = "https://azucaregiver.com";

const canonicalUrl = canonical
? new URL(canonical, siteUrl).toString()
: new URL(Astro.url.pathname, siteUrl).toString();
